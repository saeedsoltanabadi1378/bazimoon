# Copy this file to .env and fill in real values. Do not commit .env or real secrets.
# Used by docker-compose.yml to configure the postgres/redis/api/bot/frontend services.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Agora (voice) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Postgres ---
POSTGRES_DB=bazimoon
POSTGRES_USER=bazimoon
POSTGRES_PASSWORD=

# --- Auth ---
# A long, random string (32+ chars) used to sign JWTs. Generate with e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=

# Shared dashboard login. Keep the real password only in deployment environment variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Public URLs ---
# Where the Api is reachable from the internet (used for CORS + baked into the frontend build).
PUBLIC_API_BASE_URL=https://api.bazimoon.com
# Where the frontend is reachable from the internet (used for CORS).
PUBLIC_FRONTEND_ORIGIN=https://bazimoon.com
# The public Mini App URL configured for @BazimoonGamesBot in BotFather.
MINI_APP_BASE_URL=https://bazimoon.com
# Telegram link used when someone opens the website outside Telegram.
TELEGRAM_MINI_APP_URL=https://t.me/BazimoonGamesBot

# --- Environment ---
# Local | Development | Stage | Production
ASPNETCORE_ENVIRONMENT=Production
SOLO_TEST_ENABLED=false

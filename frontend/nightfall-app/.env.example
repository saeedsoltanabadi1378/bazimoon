# Base URL of Nightfall.Api (no trailing slash), e.g. https://api.nightfall.example.com
VITE_API_BASE_URL=http://localhost:5299

# Agora App ID (public, safe to ship to clients — NOT the App Certificate, which stays server-side).
VITE_AGORA_APP_ID=

# Public t.me link to this Mini App (e.g. https://t.me/NightfallBot/app). Used for "Share to group"
# and Couple Quiz invite links; falls back to the page URL when unset.
VITE_MINI_APP_URL=

# Base URL of Bazimoon.Api (no trailing slash), e.g. https://api.bazimoon.example.com
VITE_API_BASE_URL=https://api.bazimoon.com

# Agora App ID (public, safe to ship to clients — NOT the App Certificate, which stays server-side).
VITE_AGORA_APP_ID=

# Public address of the app (no trailing slash), used in invite and share links.
# Falls back to the page origin when unset.
VITE_APP_URL=https://bazimoon.com

# OAuth client id for Sign in with Google (the same one the Api uses as Google__ClientId).
VITE_GOOGLE_CLIENT_ID=
